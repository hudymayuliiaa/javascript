	"item": [
		{
			"name": "Book ISBN Numbers",
			"item": [
				{
					"name": "Is Valid ISBN13 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const cheerio = require('cheerio');\r",
									"const $ = cheerio.load(pm.response.text());\r",
									"\r",
									"pm.test(\"ISBN is valid\", function () {\r",
									"    let isValid = $(\"m\\\\:IsValidISBN13Result\").text(); \r",
									"    pm.expect(isValid).to.equal(\"true\");\r",
									"});\r",
									"\r",
									"pm.test(\"Content-Type is application/xml\", function () {\r",
									"    let contentType = pm.response.headers.get(\"Content-Type\"); \r",
									"    pm.expect(contentType).to.include(\"text/xml; charset=utf-8\");\r",
									"});\r",
									"\r",
									"pm.test(\"URL is correct\", function () {\r",
									"    let url = pm.request.url.toString(); \r",
									"    pm.expect(url).to.equal(\"http://webservices.daehosting.com/services/isbnservice.wso\");\r",
									"});\r",
									"\r",
									"pm.test(\"XML soap\", function () {\r",
									"    let xmlVersion = $('soap\\\\:Envelope').attr('xmlns:soap');\r",
									"    pm.expect(xmlVersion).to.equal(\"http://schemas.xmlsoap.org/soap/envelope/\");\r",
									"});\r",
									" \r",
									"pm.test(\"XML declaration contains version 1.0\", function () {   \r",
									"    pm.expect(pm.response.text()).to.include('<?xml version=\"1.0\"');\r",
									"});\r",
									"\r",
									"pm.test(\"Contains <soap:Body>\", function () {\r",
									"    pm.expect(pm.response.text()).to.include(\"<soap:Body>\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response body is not empty\", function () {\r",
									"    pm.expect(pm.response.text()).to.not.be.empty;\r",
									"});\r",
									"\r",
									"pm.test(\"Contains <m:IsValidISBN13Result>\", function () {\r",
									"    pm.expect($(\"m\\\\:IsValidISBN13Result\").length).to.be.at.least(1);\r",
									"});\r",
									"\r",
									"pm.test(\"Envelope exists\", function () {\r",
									"    pm.expect($(\"soap\\\\:Envelope\").length).to.be.above(0);\r",
									"});\r",
									"\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "text/xml; charset=utf-8",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <IsValidISBN13 xmlns=\"http://webservices.daehosting.com/ISBN\">\n      <sISBN>978-1-4612-9090-2</sISBN>\n    </IsValidISBN13>\n  </soap:Body>\n</soap:Envelope>"
						},
						"url": {
							"raw": "http://webservices.daehosting.com/services/isbnservice.wso",
							"protocol": "http",
							"host": [
								"webservices",
								"daehosting",
								"com"
							],
							"path": [
								"services",
								"isbnservice.wso"
							]
						},
						"description": "The test is done by calculation on the first 12 digits and compare the result with the checksum number at the end. You have to pass a 13 digits number."
					},
					"response": []
				},
				{
					"name": "Is Valid ISBN10 Number",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"let responseJson = xml2Json(pm.response.text());\r",
									"\r",
									"pm.test(\"Content-Type is XML\", function () {\r",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"xml\");\r",
									"});\r",
									"\r",
									"pm.test(\"Response body is not empty\", function () {\r",
									"    pm.expect(pm.response.text()).to.not.be.empty;\r",
									"});\r",
									"\r",
									"pm.test(\"Envelope exists\", function () {\r",
									"    pm.expect(responseJson).to.have.property(\"soap:Envelope\");\r",
									"});\r",
									"\r",
									"pm.test(\"Body exists\", function () {\r",
									"    pm.expect(responseJson[\"soap:Envelope\"]).to.have.property(\"soap:Body\");\r",
									"});\r",
									"\r",
									"pm.test(\"IsValidISBN10Response exists\", function () {\r",
									"    pm.expect(responseJson[\"soap:Envelope\"][\"soap:Body\"]).to.have.property(\"m:IsValidISBN10Response\");\r",
									"});\r",
									"\r",
									"pm.test(\"IsValidISBN10Result exists\", function () {\r",
									"    pm.expect(responseJson[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN10Response\"]).to.have.property(\"m:IsValidISBN10Result\");\r",
									"});\r",
									"\r",
									"pm.test(\"Result is true\", function () {\r",
									"    pm.expect(responseJson[\"soap:Envelope\"][\"soap:Body\"][\"m:IsValidISBN10Response\"][\"m:IsValidISBN10Result\"]).to.eql(\"true\");\r",
									"});\r",
									"\r",
									"pm.test(\"Envelope namespace is correct\", function () {\r",
									"    pm.expect(responseJson[\"soap:Envelope\"][\"$\"][\"xmlns:soap\"]).to.eql(\"http://schemas.xmlsoap.org/soap/envelope/\");\r",
									"});\r",
									"\r",
									"\r",
									"pm.test(\"Status code is 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"pm.test(\"Response time is less than 2000ms\", function () {\r",
									"    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
									"});\r",
									"\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
